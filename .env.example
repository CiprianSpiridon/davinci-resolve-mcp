# davinci-resolve-mcp — optional environment configuration.
#
# Every variable here is OPTIONAL. If unset, the server auto-detects the
# platform defaults (see src/davinci_resolve_mcp/connection.py).

# Path to the fusionscript shared library.
#   macOS:   /Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so
#   Windows: C:\Program Files\Blackmagic Design\DaVinci Resolve\fusionscript.dll
#   Linux:   /opt/resolve/libs/Fusion/fusionscript.so
# RESOLVE_SCRIPT_LIB=

# Path to the Developer/Scripting directory shipped with Resolve. Its "Modules"
# subfolder is added to sys.path so `import DaVinciResolveScript` works.
#   macOS:   /Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting
#   Windows: %PROGRAMDATA%\Blackmagic Design\DaVinci Resolve\Support\Developer\Scripting
#   Linux:   /opt/resolve/Developer/Scripting
# RESOLVE_SCRIPT_API=

# Logging verbosity for the MCP server (DEBUG, INFO, WARNING, ERROR). Default: INFO.
# RESOLVE_MCP_LOG_LEVEL=INFO
